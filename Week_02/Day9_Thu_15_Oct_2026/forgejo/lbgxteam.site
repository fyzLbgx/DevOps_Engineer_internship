server {
    server_name lbgxteam.site www.lbgxteam.site;

    client_max_body_size 512M;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    listen [::]:443 ssl; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/lbgxteam.site/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/lbgxteam.site/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


}
server {
    if ($host = www.lbgxteam.site) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = lbgxteam.site) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name lbgxteam.site www.lbgxteam.site;
    return 404; # managed by Certbot




}